# Copy to .env and fill in. Never commit .env.

PORT=5000
NODE_ENV=development            # set to "production" on the host

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DB_NAME=shopsphere

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string   # e.g. openssl rand -base64 32
# Public URL used for cookies and OAuth callbacks.
#   local:      http://localhost:5000
#   production (recommended): the FRONTEND origin, same as CLIENT_URL, with the frontend rewriting /api/* to this server
BETTER_AUTH_URL=http://localhost:5000
GOOGLE_CLIENT_ID=                                  # optional: enables "Continue with Google"
GOOGLE_CLIENT_SECRET=
# Google redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/google

# Frontend origin (CORS, Stripe redirect URLs, Better Auth trusted origin). https, no trailing slash in production.
CLIENT_URL=http://localhost:5173

# Stripe: TEST MODE ONLY (sk_live_ keys are rejected at startup)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                    # printed by `stripe listen`

# Store rules (optional, defaults shown)
# CURRENCY=usd
# TAX_RATE=0.08
# SHIPPING_FLAT=5.99
# FREE_SHIPPING_OVER=75

# Seed passwords for the demo accounts (optional, defaults in README)
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=
